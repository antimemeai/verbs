opam-version: "2.0"
name: "verbs"
version: "0.1.0"
synopsis: "Explicit, named constraints for more verifiable agent-written code"
maintainer: "Patrick Beam <hiya@antimeme.ai>"
authors: "Patrick Beam"
license: "MIT"
homepage: "https://github.com/antimemeai/verbs"
bug-reports: "https://github.com/antimemeai/verbs/issues"
dev-repo: "git+https://github.com/antimemeai/verbs.git"
depends: ["ocaml" {>= "4.08.0"}]
build: [make "-C" "packages/ocaml"]
run-test: [make "-C" "packages/ocaml" "test"]
install: [make "-C" "packages/ocaml" "install" "PREFIX=%{prefix}%" "LIBDIR=%{lib}%"]
description: "Evaluate a named predicate once and return the original value or a named violation."
